<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #061A3A, #0D2F66);" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank_account_management_system.controller.LoginController">

    <!-- LEFT BRANDING SECTION -->
    <left>

           <VBox alignment="CENTER_LEFT" prefHeight="800.0" prefWidth="641.0" spacing="18" style="-fx-background-color: rgba(255,255,255,0.03);" styleClass="margin">

               <padding>
                <Insets bottom="60" left="60" right="50" top="60" />
            </padding>
         <StackPane prefHeight="255.0" prefWidth="444.0" style="-fx-background-radius: 15;">
            <children>
               <StackPane minHeight="-Infinity" minWidth="-Infinity" prefHeight="200.0" prefWidth="200.0">
                  <children>
            
                                 <!-- LOGO -->
                        <ImageView fitHeight="214.0" fitWidth="446.0" preserveRatio="true" style="-fx-background-color: rgba(255,255,255,0.04); -fx-background-radius: 150;">
            
                                     <image>
                                <!-- ضع هنا مسار اللوجو -->
                                <Image url="@../assets/nexo-banner.png" />
                            </image>
            
                                 </ImageView>
                  </children>
               </StackPane>
            </children>
            <padding>
               <Insets top="-200.0" />
            </padding>
         </StackPane>

               <!-- FEATURE BOXES -->
            <VBox spacing="50">

                   <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 14;                              -fx-padding: 15;">

                       <Label style="-fx-text-fill:#22C55E;                                   -fx-font-size:16;" text="●" />
      
                       <Label style="-fx-text-fill:white;                                   -fx-font-size:15;" text="Secure Authentication System" />

                   </HBox>

                   <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 14;                              -fx-padding: 15;">

                       <Label style="-fx-text-fill:#2563EB;                                   -fx-font-size:16;" text="●" />

                       <Label style="-fx-text-fill:white;                                   -fx-font-size:15;" text="Real-Time Financial Operations" />

                   </HBox>

                   <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: rgba(255,255,255,0.04);                              -fx-background-radius: 14;                              -fx-padding: 15;">

                       <Label style="-fx-text-fill:#F59E0B;                                   -fx-font-size:16;" text="●" />

                       <Label style="-fx-text-fill:white;                                   -fx-font-size:15;" text="Modern Banking Dashboard" />

                   </HBox>

               </VBox>

           </VBox>

    </left>

    <!-- LOGIN CARD -->
    <center>

        <StackPane alignment="CENTER">

            <VBox alignment="CENTER" maxWidth="415.0" prefHeight="650.0" prefWidth="462.0" spacing="22" style="-fx-background-color: rgba(13,47,102,0.85);                          -fx-background-radius: 26;                          -fx-border-radius: 26;                          -fx-border-color: rgba(255,255,255,0.08);                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 35, 0.2, 0, 10);">

                <padding>
                    <Insets bottom="45" left="35" right="35" top="45" />
                </padding>

                <!-- LOGIN TITLE -->
                <VBox alignment="CENTER" spacing="8">

                    <Label style="-fx-text-fill:white;                                   -fx-font-size:30;                                   -fx-font-family:'Segoe UI';                                   -fx-font-weight:bold;" text="Welcome Back" />

                    <Label style="-fx-text-fill:#94A3B8;                                   -fx-font-size:14;" text="Login to continue to your dashboard" />

                </VBox>

                <!-- USERNAME -->
                <VBox alignment="CENTER_LEFT" fillWidth="true" spacing="8">

                    <Label style="-fx-text-fill:#CBD5E1;                                   -fx-font-size:13;" text="Username" />

                    <TextField fx:id="usernameField" prefHeight="46" promptText="Enter your username" style="-fx-background-color: rgba(255,255,255,0.06);                                       -fx-text-fill:white;                                       -fx-prompt-text-fill:#94A3B8;                                       -fx-background-radius:14;                                       -fx-border-radius:14;                                       -fx-border-color: rgba(255,255,255,0.08);                                       -fx-padding:0 14 0 14;                                       -fx-font-size:14;" />

                </VBox>

                <!-- PASSWORD -->
                <VBox alignment="CENTER_LEFT" fillWidth="true" spacing="8">

                    <Label style="-fx-text-fill:#CBD5E1;                                   -fx-font-size:13;" text="Password" />

                    <PasswordField fx:id="passwordField" prefHeight="46" promptText="Enter your password" style="-fx-background-color: rgba(255,255,255,0.06);                                           -fx-text-fill:white;                                           -fx-prompt-text-fill:#94A3B8;                                           -fx-background-radius:14;                                           -fx-border-radius:14;                                           -fx-border-color: rgba(255,255,255,0.08);                                           -fx-padding:0 14 0 14;                                           -fx-font-size:14;" />

                </VBox>

                <!-- ERROR LABEL -->
                <Label fx:id="errorLabel" style="-fx-text-fill:#DC2626;                               -fx-font-size:13;                               -fx-font-weight:bold;" />

                <!-- LOGIN BUTTON -->
                <Button onAction="#handleLogin" prefHeight="50" prefWidth="320" style="-fx-background-color:#2563EB;                                -fx-text-fill:white;                                -fx-font-size:15;                                -fx-font-weight:bold;                                -fx-background-radius:16;                                -fx-cursor:hand;                                -fx-effect:dropshadow(gaussian, rgba(37,99,235,0.35), 15, 0, 0, 5);" text="Login" />

                <!-- FOOTER -->
                <Label style="-fx-text-fill:#64748B;                               -fx-font-size:12;" text="Nexo Bank © 2026" />

            </VBox>

        </StackPane>

    </center>

</BorderPane>
