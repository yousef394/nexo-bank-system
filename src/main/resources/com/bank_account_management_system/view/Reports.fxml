<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1200.0" style="-fx-background-color: linear-gradient(to bottom,#041C45,#072B61);" stylesheets="@Reports.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank_account_management_system.controller.ReportsController">

    <!-- TOP NAVBAR -->
    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="80" style="-fx-background-color:#0B2554;">

            <padding>
                <Insets bottom="0" left="30" right="30" top="0" />
            </padding>

            <Label style="-fx-text-fill:white;                           -fx-font-size:30;                           -fx-font-weight:bold;" text="Reports" />

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#handleGenerateReport" prefHeight="40" prefWidth="110" style="                         -fx-background-color:#2563EB;                         -fx-text-fill:white;                         -fx-font-size:14;                         -fx-font-weight:bold;                         -fx-background-radius:12;                         -fx-cursor:hand;                     " text="Return" />
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>

        <VBox alignment="TOP_CENTER" spacing="30">

            <padding>
                <Insets bottom="35" left="35" right="35" top="35" />
            </padding>

            <!-- GENERATE CARD -->
            <VBox alignment="CENTER" maxWidth="420" spacing="18" style="                     -fx-background-color:#112D5C;                     -fx-background-radius:20;                     -fx-padding:35;                     -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.35), 20,0,0,8);                   ">

                <Label style="                         -fx-text-fill:white;                         -fx-font-size:24;                         -fx-font-weight:bold;                        " text="Generate Report" />

                <ComboBox fx:id="reportTypeBox" prefHeight="40" prefWidth="280" promptText="Select Report Type" style="                             -fx-background-radius:10;                             -fx-font-size:14;                           " />

                <Button onAction="#handleGenerateReport" prefHeight="42" prefWidth="180" style="                             -fx-background-color:#2563EB;                             -fx-text-fill:white;                             -fx-font-size:15;                             -fx-font-weight:bold;                             -fx-background-radius:12;                             -fx-cursor:hand;                         " text="Generate" />

            </VBox>

            <!-- OUTPUT CARD -->
            <VBox spacing="20" style="                     -fx-background-color:#112D5C;                     -fx-background-radius:20;                     -fx-padding:30;                     -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.35), 20,0,0,8);                   " VBox.vgrow="ALWAYS">

                <Label style="                         -fx-text-fill:white;                         -fx-font-size:24;                         -fx-font-weight:bold;                        " text="Report Analytics" />

                <!-- CHART -->
                <BarChart fx:id="reportBarChart" animated="false" legendVisible="false" prefHeight="350" style="                             -fx-background-color:transparent;                             -fx-text-fill:white;                           " title="Transactions per Account">

                    <xAxis>
                        <CategoryAxis label="Account ID" tickLabelFill="white" />
                    </xAxis>

                    <yAxis>
                        <NumberAxis label="Transactions Count" tickLabelFill="white" />
                    </yAxis>

                </BarChart>

                <PieChart fx:id="reportPieChart" legendVisible="false" managed="false" prefHeight="350" title="Transactions Distribution" visible="false" />

                <!-- DETAILS -->
                <VBox spacing="10">

                    <Label style="                             -fx-text-fill:white;                             -fx-font-size:16;                             -fx-font-weight:bold;                            " text="Report Details" />

                    <TextArea fx:id="reportArea" editable="false" prefHeight="220" style="                                 -fx-control-inner-background:#061A3A;                                 -fx-background-color:#061A3A;                                 -fx-text-fill:white;                                 -fx-font-family:'Consolas';                                 -fx-font-size:14;                                 -fx-background-radius:12;                                 -fx-border-radius:12;                                 -fx-border-color:#1E4E9B;                               " wrapText="true" />

                </VBox>

            </VBox>

        </VBox>

    </center>

</BorderPane>
