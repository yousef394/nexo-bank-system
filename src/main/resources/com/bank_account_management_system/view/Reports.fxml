<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650" prefWidth="950" stylesheets="@Reports.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.bank_account_management_system.controller.ReportsController">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" style="-fx-background-color:#0D2F66;">
            <padding>
                <Insets left="25" />
            </padding>
            <Label style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;" text="Reports" />
         <Button onAction="#handleGenerateReport" prefHeight="35" prefWidth="80.0" style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold;" text="return">
            <HBox.margin>
               <Insets left="1320.0" />
            </HBox.margin>
         </Button>
        </HBox>
    </top>

    <center>
        <VBox alignment="TOP_CENTER" spacing="30">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>

            <VBox alignment="CENTER" maxWidth="400" spacing="15" style="-fx-background-color:#16325C; -fx-background-radius:15; -fx-padding:30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);">
                <Label style="-fx-text-fill:white; -fx-font-size:18; -fx-font-weight:bold;" text="Generate Report" />
                <ComboBox fx:id="reportTypeBox" prefWidth="250" promptText="Select Report Type" style="-fx-background-radius:8;" />
                <Button onAction="#handleGenerateReport" prefHeight="35" prefWidth="160" style="-fx-background-color:#2563EB; -fx-text-fill:white; -fx-background-radius:8; -fx-font-weight:bold;" text="Generate" />
            </VBox>

            <VBox maxWidth="850" style="-fx-background-color:#16325C; -fx-background-radius:15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 15, 0, 0, 5);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="20" left="25" right="25" top="20" />
                </padding>

                <Label style="-fx-text-fill:white; -fx-font-size:16; -fx-font-weight:bold;" text="Report Output" />

                <BarChart fx:id="reportBarChart" animated="false" legendVisible="false" prefHeight="350" title="Transactions per Account">
                    <xAxis><CategoryAxis label="Account ID" tickLabelFill="white" /></xAxis>
                    <yAxis><NumberAxis label="Count" tickLabelFill="white" /></yAxis>
                </BarChart>

                <PieChart fx:id="reportPieChart" legendSide="RIGHT" legendVisible="false" managed="false" prefHeight="350" title="Transactions Distribution" visible="false" />

                <Label style="-fx-text-fill:white; -fx-padding: 10 0 0 0;" text="Report Details" />
                <TextArea fx:id="reportArea" editable="false" prefHeight="300" style="-fx-font-family: 'Consolas', monospace; -fx-control-inner-background:#061A3A; -fx-text-fill: white; -fx-background-color: #061A3A; -fx-border-color: #1A4281; -fx-border-radius: 5; -fx-background-radius: 5;" wrapText="true" VBox.vgrow="ALWAYS" />
            </VBox>
        </VBox>
    </center>
</BorderPane>
