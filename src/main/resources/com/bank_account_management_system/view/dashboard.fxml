<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.geometry.Pos?>
        <?import javafx.scene.control.*?>
        <?import javafx.scene.image.Image?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.*?>

<BorderPane prefHeight="780"
            prefWidth="1280"
            style="-fx-background-color: linear-gradient(to bottom right, #061A3A, #082044);"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bank_account_management_system.controller.DashboardController">

    <!-- ================= TOP NAVBAR ================= -->

    <top>

        <HBox alignment="CENTER_LEFT"
              prefHeight="85"
              spacing="18"
              style="-fx-background-color: rgba(13,47,102,0.92);
                     -fx-border-color: rgba(255,255,255,0.05);
                     -fx-border-width: 0 0 1 0;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 15, 0, 0, 3);">

            <padding>
                <Insets top="15" right="30" bottom="15" left="30"/>
            </padding>

            <!-- LOGO -->
            <ImageView fitHeight="55"
                       fitWidth="55"
                       preserveRatio="true">

                <image>
                    <Image url="@../assets/nexo-logo.png"/>
                </image>

            </ImageView>

            <!-- BRANDING -->
            <VBox spacing="2">

                <Label text="Nexo Bank"
                       style="-fx-text-fill:#F8FAFC;
                              -fx-font-size:28;
                              -fx-font-family:'Segoe UI';
                              -fx-font-weight:bold;" />

                <Label text="Smart Banking. Total Control."
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-size:12;" />

            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- USER STATUS -->
            <HBox alignment="CENTER"
                  spacing="10"
                  style="-fx-background-color: rgba(255,255,255,0.05);
                         -fx-background-radius: 16;
                         -fx-padding: 10 18 10 18;">

                <Label text="●"
                       style="-fx-text-fill:#22C55E;
                              -fx-font-size:14;" />

                <Label text="System Active"
                       style="-fx-text-fill:white;
                              -fx-font-size:14;" />

            </HBox>

            <!-- LOGOUT -->
            <Button text="Logout"
                    onAction="#handleLogout"
                    prefWidth="130"
                    prefHeight="45"
                    style="-fx-background-color:#2563EB;
                           -fx-text-fill:white;
                           -fx-font-size:14;
                           -fx-font-weight:bold;
                           -fx-background-radius:14;
                           -fx-cursor:hand;
                           -fx-effect:dropshadow(gaussian, rgba(37,99,235,0.35), 15, 0, 0, 4);" />

        </HBox>

    </top>

    <!-- ================= CENTER ================= -->

    <center>

        <VBox spacing="28">

            <padding>
                <Insets top="28" right="30" bottom="28" left="30"/>
            </padding>

            <!-- WELCOME -->

            <VBox spacing="6">

                <Label fx:id="welcomeLabel"
                       text="Welcome Back, Yousef"
                       style="-fx-text-fill:#F8FAFC;
                              -fx-font-size:34;
                              -fx-font-weight:bold;" />

                <Label text="Monitor your banking operations and financial activities."
                       style="-fx-text-fill:#94A3B8;
                              -fx-font-size:15;" />

            </VBox>

            <!-- ================= ANALYTICS CARDS ================= -->

            <HBox spacing="22">

                <!-- TOTAL BALANCE -->

                <VBox HBox.hgrow="ALWAYS"
                      prefHeight="155"
                      spacing="18"
                      style="-fx-background-color: rgba(13,47,102,0.92);
                             -fx-background-radius:22;
                             -fx-border-radius:22;
                             -fx-border-color: rgba(59,130,246,0.35);
                             -fx-border-width:1;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.28), 20, 0, 0, 6);">

                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Total Balance"
                               style="-fx-text-fill:#CBD5E1;
                                      -fx-font-size:16;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="●"
                               style="-fx-text-fill:#3B82F6;
                                      -fx-font-size:18;" />

                    </HBox>

                    <Label fx:id="totalBalanceLabel"
                           text="0"
                           style="-fx-text-fill:#F8FAFC;
                                  -fx-font-size:40;
                                  -fx-font-weight:bold;" />

                    <Label text="Overall account liquidity"
                           style="-fx-text-fill:#64748B;
                                  -fx-font-size:13;" />

                </VBox>

                <!-- ACCOUNTS -->

                <VBox HBox.hgrow="ALWAYS"
                      prefHeight="155"
                      spacing="18"
                      style="-fx-background-color: rgba(13,47,102,0.92);
                             -fx-background-radius:22;
                             -fx-border-radius:22;
                             -fx-border-color: rgba(34,197,94,0.35);
                             -fx-border-width:1;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.28), 20, 0, 0, 6);">

                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Accounts Count"
                               style="-fx-text-fill:#CBD5E1;
                                      -fx-font-size:16;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="●"
                               style="-fx-text-fill:#22C55E;
                                      -fx-font-size:18;" />

                    </HBox>

                    <Label fx:id="totalAccountsLabel"
                           text="0"
                           style="-fx-text-fill:#F8FAFC;
                                  -fx-font-size:40;
                                  -fx-font-weight:bold;" />

                    <Label text="Registered active accounts"
                           style="-fx-text-fill:#64748B;
                                  -fx-font-size:13;" />

                </VBox>

                <!-- LOANS -->

                <VBox HBox.hgrow="ALWAYS"
                      prefHeight="155"
                      spacing="18"
                      style="-fx-background-color: rgba(13,47,102,0.92);
                             -fx-background-radius:22;
                             -fx-border-radius:22;
                             -fx-border-color: rgba(249,115,22,0.35);
                             -fx-border-width:1;
                             -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.28), 20, 0, 0, 6);">

                    <padding>
                        <Insets top="22" right="24" bottom="22" left="24"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">

                        <Label text="Loans"
                               style="-fx-text-fill:#CBD5E1;
                                      -fx-font-size:16;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="●"
                               style="-fx-text-fill:#F97316;
                                      -fx-font-size:18;" />

                    </HBox>

                    <Label fx:id="loanCountLabel"
                           text="0"
                           style="-fx-text-fill:#F8FAFC;
                                  -fx-font-size:40;
                                  -fx-font-weight:bold;" />

                    <Label text="Current active loan accounts"
                           style="-fx-text-fill:#64748B;
                                  -fx-font-size:13;" />

                </VBox>

            </HBox>

            <!-- ================= TABLE SECTION ================= -->

            <VBox spacing="16"
                  style="-fx-background-color: rgba(13,47,102,0.88);
                         -fx-background-radius:24;
                         -fx-border-radius:24;
                         -fx-border-color: rgba(255,255,255,0.05);
                         -fx-border-width:1;
                         -fx-effect:dropshadow(gaussian, rgba(0,0,0,0.30), 20, 0, 0, 6);">

                <padding>
                    <Insets top="22" right="22" bottom="22" left="22"/>
                </padding>

                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="4">

                        <Label text="Accounts Overview"
                               style="-fx-text-fill:#F8FAFC;
                                      -fx-font-size:24;
                                      -fx-font-weight:bold;" />

                        <Label text="Manage and monitor all banking accounts"
                               style="-fx-text-fill:#94A3B8;
                                      -fx-font-size:13;" />

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Label text="Live Data"
                           style="-fx-background-color: rgba(34,197,94,0.12);
                                  -fx-text-fill:#22C55E;
                                  -fx-padding:8 14 8 14;
                                  -fx-background-radius:14;
                                  -fx-font-size:12;
                                  -fx-font-weight:bold;" />

                </HBox>

                <!-- TABLE -->

                <TableView fx:id="accountsTable"
                           prefHeight="360"
                           style="-fx-background-color: transparent;
                                  -fx-control-inner-background:#102B59;
                                  -fx-table-cell-border-color: rgba(255,255,255,0.03);
                                  -fx-selection-bar:#2563EB;
                                  -fx-selection-bar-text:white;
                                  -fx-font-size:14;
                                  -fx-background-radius:18;">

                    <columns>

                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="180"/>

                        <TableColumn fx:id="balanceColumn"
                                     text="Balance"
                                     prefWidth="260"/>

                        <TableColumn fx:id="nameColumn"
                                     text="Name"
                                     prefWidth="320"/>

                        <TableColumn fx:id="typeColumn"
                                     text="Type"
                                     prefWidth="260"/>

                    </columns>

                </TableView>

            </VBox>

            <!-- ================= ACTION BUTTONS ================= -->

            <VBox spacing="16">

                <Label text="Quick Actions"
                       style="-fx-text-fill:#F8FAFC;
                              -fx-font-size:22;
                              -fx-font-weight:bold;" />

                <HBox spacing="18"
                      alignment="CENTER_LEFT">

                    <Button text="Deposit"
                            onAction="#handleDeposit"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#2563EB;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                    <Button text="Withdraw"
                            onAction="#handleWithdraw"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#DC2626;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                    <Button text="Transfer"
                            onAction="#handleTransfer"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#7C3AED;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                    <Button text="View Reports"
                            onAction="#handleReports"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#4F46E5;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                    <Button text="Add Account"
                            onAction="#handleAddAccount"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#16A34A;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                    <Button text="Delete Account"
                            onAction="#handleDeleteAccount"
                            prefWidth="170"
                            prefHeight="54"
                            style="-fx-background-color:#B91C1C;
                                   -fx-text-fill:white;
                                   -fx-font-size:14;
                                   -fx-font-weight:bold;
                                   -fx-background-radius:16;
                                   -fx-cursor:hand;" />

                </HBox>

            </VBox>

            <!-- ================= FOOTER ================= -->

            <HBox alignment="CENTER_LEFT">

                <Label text="Last Updated: Today"
                       style="-fx-text-fill:#64748B;
                              -fx-font-size:13;" />

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="Nexo Bank © 2026"
                       style="-fx-text-fill:#64748B;
                              -fx-font-size:13;" />

            </HBox>

        </VBox>

    </center>

</BorderPane>